   "source": [
    "def sqrt(n):\n",
    "    i = 0\n",
    "    j = n\n",
    "    ans = 0\n",
    "\n",
    "    while i <=j:\n",
    "        mid = i +(j-i)//2\n",
    "        if mid* mid ==n:\n",
    "            return mid\n",
    "\n",
    "\n",
    "        if mid*mid >= n:\n",
    "            j = mid -1\n",
    "        else:\n",
    "            ans = mid\n",
    "            i = mid +1\n",
    "\n",
    "\n",
    "    return ans"
   ]
  },
